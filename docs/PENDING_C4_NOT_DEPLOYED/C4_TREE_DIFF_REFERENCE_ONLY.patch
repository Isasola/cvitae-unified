+    count(*) filter(where inventory_gate='OWNER_MISSING')::integer owner_missing,
+    coalesce(sum(mirror_count),0)::integer existing_mirrors,
+    count(*) filter(where mirror_count>0)::integer rows_with_existing_mirror
