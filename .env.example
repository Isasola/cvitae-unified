# Frontend (prefijo VITE_ requerido para que Vite las exponga al cliente)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Medición y publicidad: los scripts solo cargan después del consentimiento.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_JOBS=0000000000
VITE_ADSENSE_SLOT_OPPORTUNITIES=0000000000
VITE_ADSENSE_SLOT_BLOG=0000000000
# Activar únicamente después de aprobar AdSense y configurar una CMP certificada por Google.
VITE_GOOGLE_ADSENSE_READY=false
VITE_GOOGLE_CERTIFIED_CMP_READY=false
# Solo para revisar visualmente los espacios locales; mantener false en producción.
VITE_ADSENSE_PREVIEW=false

# Backend — Netlify Functions (nunca exponer al cliente)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_KEY=tu_anon_key_aqui

# AWS Bedrock (usar estos nombres exactos en Netlify, no los estándar AWS_*)
CVITAE_AWS_ACCESS_KEY_ID=AKIA...
CVITAE_AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
CVITAE_AWS_REGION=us-east-1

# Email
RESEND_API_KEY=re_...
SITE_URL=https://cvitae.lat

# Panel admin: Google Analytics Data API + Search Console API (opcionales)
# Compartir la propiedad GA4 y la propiedad Search Console con client_email.
GA4_PROPERTY_ID=123456789
SEARCH_CONSOLE_SITE_URL=sc-domain:cvitae.lat
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Admin
ADMIN_PASSWORD=tu_password_admin_aqui

# Otros servicios (funciones legacy, pueden quedar vacíos si no se usan)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
